# -----------------------------------------------------------------------------
# Supabase (Dashboard → Project Settings → API)
# Ohne diese beiden Werte startet die App im Demo-Modus (Daten nur im Browser).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# -----------------------------------------------------------------------------
# Optional: Push-Benachrichtigungen aufs Handy (auch wenn die App geschlossen ist)
# Schlüssel erzeugen mit:  npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:chef@example.com
# Frei wählbares Geheimnis – muss im Supabase Database Webhook als Header stehen
PUSH_WEBHOOK_SECRET=
# Nur serverseitig! (Dashboard → Project Settings → API → service_role / secret key)
SUPABASE_SERVICE_ROLE_KEY=
